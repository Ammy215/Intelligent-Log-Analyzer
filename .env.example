# ── Deployment mode ──────────────────────────────
# REQUIRED — set this explicitly in every deployment.
#
# There is no safe default. config.py falls back to "development" so a fresh
# local clone works with no setup, which means a deploy that simply forgets
# this variable does NOT fail loudly — it silently comes up in development
# mode with /docs, /redoc and /openapi.json publicly served. Set it to
# "production" in your host's environment config (Render/Railway dashboard,
# not this file) as part of any deploy.
#
#   development  -> /docs, /redoc, /openapi.json served (local default)
#   production   -> all three return 404
ENVIRONMENT=development

# ── MongoDB ──────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=log_analyzer

# ── FastAPI ──────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
# Comma-separated origins allowed to call this API. Must include the exact
# scheme+host+port of the deployed frontend — a missing entry surfaces in the
# browser as an opaque CORS error, not a clear message. Add your production
# frontend origin here on deploy (e.g. https://your-app.vercel.app).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Threat Intelligence ──────────────────────────
ABUSEIPDB_API_KEY=your_key_here
OTX_API_KEY=your_key_here
IPINFO_TOKEN=your_key_here

# ── Redis (Upstash REST) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay (sandbox mode only — never goes live on this project) ─
# Key ID + Key Secret: Razorpay Dashboard > Settings > API Keys (test/sandbox mode).
# Webhook secret: Settings > Webhooks > your endpoint > Secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (transactional email) ──────────────────
# Resend Dashboard > API Keys. Sending from the shared sandbox sender
# (onboarding@resend.dev) — no custom domain/DNS verification needed.
RESEND_API_KEY=

# ── AI (Gemini — the only AI provider) ────────────
# Gemini AI Studio > Get API key (aistudio.google.com/apikey) — free tier,
# no card required. Powers every generated report: incident write-ups
# (credit-metered), executive summaries, and remediation plans.
#
# Required for report generation. With this unset, those endpoints return a
# 502 with a clear reason — deliberately, so a missing key is visible rather
# than being papered over with placeholder text presented as real analysis.
GEMINI_API_KEY=
# Primary model. Defaults to flash-lite rather than flash: gemini-flash-latest
# was returning sustained 503 "high demand" (Google-side capacity — flash-lite
# served the same requests on the same key), which failed every report call.
GEMINI_MODEL=gemini-flash-lite-latest
# Tried only if the primary returns a capacity error (503/429). Leave empty to
# disable failover and surface the primary's error directly.
GEMINI_FALLBACK_MODEL=gemini-flash-latest
MAX_TOKENS=2000

# ── Supabase (Auth + Postgres) ────────────────────
# Project Settings > API for URL/anon/service keys. No JWT secret needed —
# this project verifies tokens via Supabase's public JWKS endpoint instead.
# SUPABASE_SERVICE_KEY bypasses RLS — never expose it to the frontend or log it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── App Settings ─────────────────────────────────
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
ALLOWED_LOG_EXTENSIONS=.log,.txt,.xml,.evtx,.csv

# Note: the frontend's own backend URL is NOT configured here — it is a
# build-time Vite variable. See frontend/.env.example (VITE_API_URL).
