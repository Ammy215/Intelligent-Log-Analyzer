# ── MongoDB ──────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=log_analyzer

# ── FastAPI ──────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
SECRET_KEY=replace_with_random_64_char_string
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000,http://localhost:5173

# ── Threat Intelligence ──────────────────────────
ABUSEIPDB_API_KEY=your_key_here
OTX_API_KEY=your_key_here
IPINFO_TOKEN=your_key_here

# ── Redis (Upstash REST) ──────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Razorpay (sandbox mode only — never goes live on this project) ─
# Key ID + Key Secret: Razorpay Dashboard > Settings > API Keys (test/sandbox mode).
# Webhook secret: Settings > Webhooks > your endpoint > Secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (transactional email) ──────────────────
# Resend Dashboard > API Keys. Sending from the shared sandbox sender
# (onboarding@resend.dev) — no custom domain/DNS verification needed.
RESEND_API_KEY=

# ── AI ───────────────────────────────────────────
OPENAI_API_KEY=your_key_here
OPENAI_MODEL=gpt-4o-mini
# Gemini AI Studio > Get API key (aistudio.google.com/apikey) — free tier,
# no card required. Powers the credit-metered AI Analyst (Phase 9).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
MAX_TOKENS=2000

# ── Supabase (Auth + Postgres) ────────────────────
# Project Settings > API for URL/anon/service keys. No JWT secret needed —
# this project verifies tokens via Supabase's public JWKS endpoint instead.
# SUPABASE_SERVICE_KEY bypasses RLS — never expose it to the frontend or log it.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Dashboard ────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
API_BASE_URL=http://localhost:8000/api/v1

# ── App Settings ─────────────────────────────────
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=50
ALLOWED_LOG_EXTENSIONS=.log,.txt,.xml,.evtx,.csv
